+/* ---------- Service detail pages (/services/{slug}) ---------- */
+.eda-service-page .lead { font-size: 1.15rem; color: #2f3a4c; }
+
+.eda-service-tags { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; padding: 0; margin: 0 0 1.25rem; }
+.eda-service-tags li {
+  padding: .45rem 1rem;
+  border-radius: 2rem;
+  background: var(--bs-success-bg-subtle);
+  color: var(--eda-green-dark);
+  font-weight: 700;
+  font-size: .95rem;
+}
+
+/* The sticky side box only sticks where the screen is tall enough to show all of it */
+.eda-project-info.eda-service-aside { position: static; }
+@media (min-width: 992px) and (min-height: 820px) {
+  .eda-project-info.eda-service-aside { position: sticky; }
+}
+
+.eda-service-links { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #e1e7f0; }
+.eda-service-links h3 { font-size: 1.05rem; margin-bottom: .5rem; }
+.eda-service-links ul { list-style: none; padding: 0; margin: 0; }
+/* Undo the 3-column grid that .eda-project-info gives its own list items */
+.eda-project-info .eda-service-links li { display: block; padding: 0; border-bottom: 1px solid #e1e7f0; }
+.eda-project-info .eda-service-links li:last-child { border-bottom: 0; }
+.eda-service-links a {
+  display: flex;
+  align-items: center;
+  gap: .6rem;
+  padding: .5rem 0;
+  font-weight: 600;
+  text-decoration: none;
+}
+.eda-service-links i { color: var(--eda-green); font-size: 1.1rem; }
+.eda-service-links a:hover { color: var(--eda-green); }
+
+.eda-faq { max-width: 900px; margin-inline: auto; display: grid; gap: .85rem; }
+.eda-faq details { border: 1px solid #e6ebf3; border-radius: 1rem; background: #fff; padding: 0 1.25rem; }
+.eda-faq summary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 1.1rem 0;
+  cursor: pointer;
+  list-style: none;
+}
+.eda-faq summary::-webkit-details-marker { display: none; }
+.eda-faq summary h3 { font-size: 1.05rem; margin: 0; }
+/* Small chevron that points down when closed and up when open */
+.eda-faq summary::after {
+  content: "";
+  flex: none;
+  width: .6rem;
+  height: .6rem;
+  margin-top: -.3rem;
+  border-right: 2px solid var(--eda-green);
+  border-bottom: 2px solid var(--eda-green);
+  transform: rotate(45deg);
+  transition: transform .2s ease;
+}
+.eda-faq details[open] summary::after { transform: rotate(-135deg); margin-top: .3rem; }
+.eda-faq details p { color: #5d6778; margin: 0 0 1.1rem; }
+
 /* ---------- Error pages ---------- */
