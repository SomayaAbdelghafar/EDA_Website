new file mode 100644
index 0000000..86efcbc
--- /dev/null
+++ b/Controllers/SeoController.cs
@@ -0,0 +1,61 @@
+using System.Text;
+using System.Xml.Linq;
+using Microsoft.AspNetCore.Mvc;
+using EDA_Website.Data;
+using EDA_Website.Models;
+using EDA_Website.Services;
+
+namespace EDA_Website.Controllers;
+
+/// <summary>
+/// robots.txt and sitemap.xml for search engines. The sitemap is built from <see cref="CompanyData"/>,
+/// so a new service or project is listed automatically. Submit /sitemap.xml in Google Search Console.
+/// </summary>
+public class SeoController(IConfiguration config) : Controller
+{
+    private static readonly XNamespace SitemapNs = "http://www.sitemaps.org/schemas/sitemap/0.9";
+    private static readonly XNamespace ImageNs = "http://www.google.com/schemas/sitemap-image/1.1";
+
+    [HttpGet("robots.txt")]
+    public IActionResult Robots()
+    {
+        var text = new StringBuilder();
+        text.AppendLine("User-agent: *");
+        // A preview copy must stay out of search results; the live site is open to all crawlers
+        text.AppendLine(config.GetValue<bool>("StaticPreview") ? "Disallow: /" : "Allow: /");
+        text.AppendLine();
+        text.Append("Sitemap: ").AppendLine(SiteUrls.Absolute(Request, config, "/sitemap.xml"));
+        return Content(text.ToString(), "text/plain", Encoding.UTF8);
+    }
+
+    [HttpGet("sitemap.xml")]
+    public IActionResult Sitemap()
+    {
+        var baseUrl = SiteUrls.Base(Request, config);
+
+        // One <url> per indexable page; photos are listed too so they can appear in Google Images
+        XElement Page(string path, IEnumerable<string>? images = null) =>
+            new(SitemapNs + "url",
+                new XElement(SitemapNs + "loc", SiteUrls.Absolute(baseUrl, path)),
+                images?.Select(src => new XElement(ImageNs + "image",
+                    new XElement(ImageNs + "loc", SiteUrls.Absolute(baseUrl, src)))));
+
+        var pages = new List<XElement>
+        {
+            Page("/", ["/images/site/hero.jpg"]),
+            Page("/services")
+        };
+        pages.AddRange(CompanyData.Services.Select(s => Page($"/services/{s.Slug}", [s.Image])));
+        pages.Add(Page("/projects"));
+        pages.AddRange(Enum.GetValues<ProjectCategory>().Select(c => Page($"/projects?category={CompanyData.CategorySlug(c)}")));
+        pages.AddRange(CompanyData.Projects.Select(p => Page($"/projects/{p.Slug}", p.ImageUrls)));
+        pages.Add(Page("/about"));
+        pages.Add(Page("/contact"));
+        pages.Add(Page("/privacy"));
+
+        var sitemap = new XDocument(
+            new XDeclaration("1.0", "utf-8", null),
+            new XElement(SitemapNs + "urlset", new XAttribute(XNamespace.Xmlns + "image", ImageNs), pages));
+        return Content(sitemap.Declaration + Environment.NewLine + sitemap, "application/xml", Encoding.UTF8);
+    }
+}
