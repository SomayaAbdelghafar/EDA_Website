@model Project
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = Model.City;
    ViewData["Description"] = Model.Summary;
    ViewData["HeaderImage"] = $"/images/projects/{Model.Slug}/1.jpg";
    ViewData["Breadcrumb"] = ((string, string)?)("سابقة الأعمال", Url.Action("Index", "Projects")!);
    var images = Model.ImageUrls.ToList();
    var related = CompanyData.Projects.Where(p => p.Category == Model.Category && p.Slug != Model.Slug).Take(3).ToList();
    var index = CompanyData.Projects.ToList().IndexOf(Model);
    var prev = index > 0 ? CompanyData.Projects[index - 1] : null;
    var next = index < CompanyData.Projects.Count - 1 ? CompanyData.Projects[index + 1] : null;

    // Thumbnails sit on a 6-column grid, 3 per row; a short last row stretches so no photo is left alone.
    var thumbs = images.Count - 1;
    string ThumbSpan(int k)
    {
        if (thumbs == 1) return "g-span-6";
        if (thumbs == 2) return "g-span-3";
        return (thumbs % 3) switch
        {
            0 => "g-span-2",
            2 => k >= thumbs - 2 ? "g-span-3" : "g-span-2",
            _ => k >= thumbs - 4 ? "g-span-3" : "g-span-2" // remainder 1: last four become a 2×2 block
        };
    }
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <div class="eda-gallery">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <a href="@images[i]" class="@(i == 0 ? "eda-gallery-main" : ThumbSpan(i - 1))" data-eda-lightbox="project" data-caption="@Model.Title">
                            <img src="@images[i]" alt="@Model.Title – صورة @(i + 1)" loading="@(i == 0 ? "eager" : "lazy")" />
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="eda-project-info">
                    <h2>عن المشروع</h2>
                    <p>@Model.Summary</p>
                    <ul>
                        <li><i class="bi bi-geo-alt"></i><span>الموقع</span><strong>@Model.City</strong></li>
                        <li><i class="bi bi-tag"></i><span>التصنيف</span>
                            <strong><a asp-action="Index" asp-route-category="@CompanyData.CategorySlug(Model.Category)">@CompanyData.CategoryTitle(Model.Category)</a></strong></li>
                        <li><i class="bi bi-images"></i><span>الصور</span><strong>@images.Count</strong></li>
                        <li><i class="bi bi-building"></i><span>المنفذ</span><strong>@CompanyData.NameAr</strong></li>
                    </ul>
                    <a class="btn btn-success w-100" asp-controller="Home" asp-action="Contact"><i class="bi bi-send"></i> اطلب مشروعًا مماثلًا</a>
                    <a class="btn btn-outline-success w-100 mt-2" href="@CompanyData.WhatsAppUrl($"استفسار بخصوص مشروع مشابه لـ: {Model.Title}")" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> تواصل عبر واتساب</a>
                </aside>
            </div>
        </div>

        <nav class="eda-prevnext" aria-label="التنقل بين المشاريع">
            @if (prev is not null)
            {
                <a asp-action="Details" asp-route-slug="@prev.Slug"><i class="bi bi-arrow-right"></i><span><small>المشروع السابق</small>@prev.Title</span></a>
            }
            else { <span></span> }
            @if (next is not null)
            {
                <a asp-action="Details" asp-route-slug="@next.Slug" class="text-start"><span><small>المشروع التالي</small>@next.Title</span><i class="bi bi-arrow-left"></i></a>
            }
        </nav>
    </div>
</section>

@if (related.Count > 0)
{
    <section class="eda-section eda-section-alt">
        <div class="container">
            <div class="eda-section-head">
                <span class="eda-eyebrow">@CompanyData.CategoryTitle(Model.Category)</span>
                <h2>مشاريع مشابهة</h2>
            </div>
            <div class="row g-4">
                @foreach (var p in related)
                {
                    <div class="col-md-6 col-lg-4"><partial name="_ProjectCard" model="p" /></div>
                }
            </div>
        </div>
    </section>
}

<partial name="_CtaBand" />
<partial name="_Lightbox" />
