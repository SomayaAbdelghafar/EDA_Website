@model IReadOnlyList<Project>
@{
    var selected = ViewData["Category"] as ProjectCategory?;
    ViewData["Subtitle"] = selected is null
        ? T["Projects.Subtitle"].Value
        : CompanyData.CategoryDescription(selected.Value);
    ViewData["HeaderImage"] = "/images/site/services-bg.jpg";
    if (selected is null)
    {
        ViewData["Title"] = T["Shared.Nav.Projects"].Value;
        ViewData["Heading"] = T["Projects.Heading"].Value;
        ViewData["SeoTitle"] = T["Projects.SeoTitle"].Value;
        ViewData["Description"] = T["Projects.Description"].Value;
        ViewData["CanonicalPath"] = "/projects"; // also for unknown ?category= values, which show the full list
    }
    else
    {
        // Each category is its own landing page (e.g. TRANE-warranty maintenance) with its own title and address
        ViewData["Title"] = CompanyData.CategoryTitle(selected.Value);
        ViewData["Breadcrumb"] = ((string, string)?)(T["Shared.Nav.Projects"], Url.Action("Index", "Projects")!);
        ViewData["SeoTitle"] = CompanyData.CategorySeoTitle(selected.Value);
        ViewData["Description"] = CompanyData.CategoryMetaDescription(selected.Value);
        ViewData["CanonicalPath"] = $"/projects?category={CompanyData.CategorySlug(selected.Value)}";
    }
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container">
        <nav class="eda-filter" aria-label="@T["Projects.FilterLabel"]">
            <a class="@(selected is null ? "active" : "")" asp-action="Index">@T["Projects.All"] <span>@CompanyData.Projects.Count</span></a>
            @foreach (var c in Enum.GetValues<ProjectCategory>())
            {
                <a class="@(selected == c ? "active" : "")" asp-action="Index" asp-route-category="@CompanyData.CategorySlug(c)">
                    @CompanyData.CategoryTitle(c) <span>@CompanyData.Projects.Count(p => p.Category == c)</span>
                </a>
            }
        </nav>

        @if (selected is null)
        {
            @foreach (var c in Enum.GetValues<ProjectCategory>())
            {
                var group = Model.Where(p => p.Category == c).ToList();
                <div class="eda-project-group">
                    <div class="eda-group-head">
                        <h2><span>@((int)c + 1)</span> @CompanyData.CategoryTitle(c)</h2>
                        <p>@CompanyData.CategoryDescription(c)</p>
                    </div>
                    <div class="row g-4">
                        @foreach (var p in group)
                        {
                            <div class="col-sm-6 col-lg-4"><partial name="_ProjectCard" model="p" /></div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-sm-6 col-lg-4"><partial name="_ProjectCard" model="p" /></div>
                }
            </div>
        }
    </div>
</section>

<partial name="_Clients" />
<partial name="_CtaBand" />
