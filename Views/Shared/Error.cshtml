@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}
<section class="eda-section">
    <div class="container text-center eda-error">
        <i class="bi bi-exclamation-triangle"></i>
        <h1>عذرًا، حدث خطأ غير متوقع</h1>
        <p class="lead">نعتذر عن الإزعاج، يرجى المحاولة مرة أخرى بعد قليل أو التواصل معنا مباشرة.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="text-secondary small" dir="ltr">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex justify-content-center flex-wrap gap-3 mt-4">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة للرئيسية</a>
            <a class="btn btn-outline-success" href="tel:@CompanyData.Phone2">اتصل بنا</a>
        </div>
    </div>
</section>
