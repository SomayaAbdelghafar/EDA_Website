<section class="eda-cta">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h2>@T["Shared.Cta.Title"]</h2>
                <p class="mb-0">@T["Shared.Cta.Text"]</p>
            </div>
            <div class="col-lg-5 d-flex flex-wrap gap-3 justify-content-lg-end">
                <a class="btn btn-light btn-lg" asp-controller="Home" asp-action="Contact"><i class="bi bi-send"></i> @T["Shared.Actions.RequestQuote"]</a>
                <a class="btn btn-outline-light btn-lg" href="tel:@CompanyData.Phone2"><i class="bi bi-telephone"></i> @T["Shared.Actions.CallNow"]</a>
            </div>
        </div>
    </div>
</section>
