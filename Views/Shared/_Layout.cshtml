@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var description = ViewData["Description"] as string
        ?? "شركة إيدا للتكييف والتبريد – تصميم وتوريد وتركيب وصيانة أنظمة التكييف المركزي والسبليت والباكدج في جدة وجميع أنحاء المملكة العربية السعودية.";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#062E6C" />
    <meta name="description" content="@description" />
    <meta property="og:title" content="@ViewData["Title"] | @CompanyData.NameAr" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="/images/site/hero.jpg" />
    <meta property="og:locale" content="ar_SA" />
    <title>@ViewData["Title"] | @CompanyData.NameAr</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EDA_Website.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable eda-skip" href="#main">تخطي إلى المحتوى</a>

    <div class="eda-topbar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <a href="tel:@CompanyData.Phone1"><i class="bi bi-telephone"></i> <span dir="ltr">@CompanyData.Phone1Display</span></a>
                <a href="tel:@CompanyData.Phone2"><i class="bi bi-telephone"></i> <span dir="ltr">@CompanyData.Phone2Display</span></a>
                <a href="mailto:@CompanyData.Email"><i class="bi bi-envelope"></i> @CompanyData.Email</a>
            </div>
            <span><i class="bi bi-geo-alt"></i> @CompanyData.Address</span>
        </div>
    </div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white eda-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="@CompanyData.NameAr" class="eda-logo" asp-append-version="true" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Home", "About")" asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Home", "Services")" asp-controller="Home" asp-action="Services">خدماتنا</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Projects")" asp-controller="Projects" asp-action="Index">سابقة الأعمال</a></li>
                        <li class="nav-item"><a class="nav-link @NavActive("Home", "Contact")" asp-controller="Home" asp-action="Contact">تواصل معنا</a></li>
                    </ul>
                    <a class="btn btn-success eda-nav-cta" asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-chat-dots"></i> اطلب عرض سعر
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="main">
        @RenderBody()
    </main>

    <footer class="eda-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="eda-footer-logo" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="@CompanyData.NameAr" asp-append-version="true" />
                    </a>
                    <p class="mt-3 mb-0">نقدم أفضل تكنولوجيا التكييف والتبريد لعملائنا في جميع أنحاء المملكة العربية السعودية: تصميم، توريد، تركيب، تشغيل وصيانة.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h3 class="eda-footer-title">روابط سريعة</h3>
                    <ul class="list-unstyled eda-footer-links">
                        <li><a asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li><a asp-controller="Home" asp-action="Services">خدماتنا</a></li>
                        <li><a asp-controller="Projects" asp-action="Index">سابقة الأعمال</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">تواصل معنا</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h3 class="eda-footer-title">خدماتنا</h3>
                    <ul class="list-unstyled eda-footer-links">
                        @foreach (var s in CompanyData.Services)
                        {
                            <li><a asp-controller="Home" asp-action="Services" asp-fragment="@s.Slug">@s.Title</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h3 class="eda-footer-title">تواصل معنا</h3>
                    <ul class="list-unstyled eda-footer-contact">
                        <li><i class="bi bi-geo-alt"></i> @CompanyData.Address</li>
                        <li><i class="bi bi-telephone"></i> <a href="tel:@CompanyData.Phone1" dir="ltr">@CompanyData.Phone1Display</a></li>
                        <li><i class="bi bi-telephone"></i> <a href="tel:@CompanyData.Phone2" dir="ltr">@CompanyData.Phone2Display</a></li>
                        <li><i class="bi bi-envelope"></i> <a href="mailto:@CompanyData.Email">@CompanyData.Email</a></li>
                        <li><i class="bi bi-patch-check"></i> سجل تجاري: @CompanyData.CrNumber</li>
                    </ul>
                </div>
            </div>
            <div class="eda-footer-bottom">
                <span>&copy; @DateTime.Now.Year @CompanyData.NameAr – جميع الحقوق محفوظة</span>
                <span dir="ltr">@CompanyData.NameEn</span>
            </div>
        </div>
    </footer>

    <a class="eda-whatsapp" href="@CompanyData.WhatsAppUrl("السلام عليكم، أرغب بالاستفسار عن خدمات التكييف")" target="_blank" rel="noopener" aria-label="تواصل عبر واتساب">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
