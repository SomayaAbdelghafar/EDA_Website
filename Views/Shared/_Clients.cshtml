<section class="eda-section eda-section-alt">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["Shared.Clients.Eyebrow"]</span>
            <h2>@T["Shared.Clients.Title"]</h2>
            <p>@T["Shared.Clients.Text"]</p>
        </div>
        <div class="eda-clients">
            @foreach (var c in CompanyData.Clients)
            {
                <div class="eda-client" title="@c.Name">
                    <img src="@c.Logo" alt="@c.Name" loading="lazy" />
                </div>
            }
        </div>
    </div>
</section>
