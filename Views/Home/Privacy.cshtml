@{
    ViewData["Title"] = T["Shared.Nav.Privacy"].Value;
    ViewData["Description"] = T["Privacy.Description"].Value;
    var analyticsOn = !string.IsNullOrWhiteSpace(Configuration["Analytics:Ga4MeasurementId"]) && !Configuration.GetValue<bool>("StaticPreview");
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container eda-prose">
        <p>@T["Privacy.Intro", CompanyData.Name]</p>
        <h2>@T["Privacy.Collected.Title"]</h2>
        <p>@T["Privacy.Collected.Text"]</p>
        <h2>@T["Privacy.Use.Title"]</h2>
        <p>@T["Privacy.Use.Text"]</p>
        <p>@T["Privacy.Use.LanguageCookie"]</p>
        <h2>@T["Privacy.ThirdParty.Title"]</h2>
        <p>@T["Privacy.ThirdParty.Text"]</p>
        @if (analyticsOn)
        {
            <p>@T["Privacy.ThirdParty.Analytics"]</p>
        }
        <h2>@T["Privacy.Contact.Title"]</h2>
        <p>@T.Html("Privacy.Contact.Text", Html.Raw($"<a href=\"mailto:{CompanyData.Email}\">{CompanyData.Email}</a>"))</p>
    </div>
</section>
