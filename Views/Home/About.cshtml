@{
    ViewData["Title"] = T["Shared.Nav.About"].Value;
    ViewData["SeoTitle"] = T["About.SeoTitle"].Value;
    ViewData["Subtitle"] = T["About.Subtitle"].Value;
    ViewData["Description"] = T["About.Description"].Value;
    ViewData["HeaderImage"] = "/images/site/rooftop.jpg";
}
<partial name="_PageHeader" />

<!-- Who we are -->
<section class="eda-section">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-lg-6 order-lg-2">
                <img src="~/images/site/rooftop.jpg" alt="@T["About.Who.ImageAlt"]" class="img-fluid rounded-4 shadow eda-cover" loading="lazy" />
                @* <img src="~/images/site/about-unit.jpg" alt="@T["About.Who.ImageAlt"]" class="img-fluid rounded-4 shadow eda-cover" loading="lazy" /> *@
            </div>
            <div class="col-lg-6">
                <span class="eda-eyebrow">@T["About.Who.Eyebrow"]</span>
                <h2 class="eda-title">@CompanyData.Name</h2>
                <p>@CompanyData.AboutIntro</p>
                <p>@CompanyData.AboutDesign</p>
                <p class="mb-0">@CompanyData.AboutSupply</p>
            </div>
        </div>
    </div>
</section>

<!-- Market position -->
<section class="eda-section eda-section-alt">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-lg-5">
                <div class="eda-gallery-duo">
                    <img src="~/images/site/about-3.jpg" alt="@T["About.Position.VanAlt"]" loading="lazy" />
                    @* <img src="~/images/site/van.jpg" alt="@T["About.Position.VanAlt"]" loading="lazy" /> *@
                    <img src="~/images/site/about-4.jpg" alt="@T["About.Position.TeamAlt"]" loading="lazy" />
                    @* <img src="~/images/site/truck.jpg" alt="@T["About.Position.TeamAlt"]" loading="lazy" /> *@
                </div>

                
            </div>
            <div class="col-lg-7">
                <span class="eda-eyebrow">@T["About.Position.Eyebrow"]</span>
                <h2 class="eda-title">@T["About.Position.Title"]</h2>
                <p>@CompanyData.AboutPosition</p>
                <div class="row g-3 mt-2">
                    <div class="col-6 col-md-3"><div class="eda-mini-stat"><strong>+@CompanyData.Projects.Count</strong><span>@T["About.Position.Projects"]</span></div></div>
                    <div class="col-6 col-md-3"><div class="eda-mini-stat"><strong>+@CompanyData.Clients.Count</strong><span>@T["About.Position.Clients"]</span></div></div>
                    <div class="col-6 col-md-3"><div class="eda-mini-stat"><strong>@CompanyData.CitiesServed.Count</strong><span>@T["About.Position.Cities"]</span></div></div>
                    <div class="col-6 col-md-3"><div class="eda-mini-stat"><strong>@CompanyData.Services.Count</strong><span>@T["About.Position.Services"]</span></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values -->
<section class="eda-section">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["About.Values.Eyebrow"]</span>
            <h2>@T["About.Values.Title"]</h2>
            <p>@T["About.Values.Text"]</p>
        </div>
        <div class="row g-4">
            @foreach (var v in CompanyData.Values)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="eda-value eda-value-card">
                        <i class="bi @v.Icon"></i>
                        <div>
                            <h3>@v.Title</h3>
                            <p>@v.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Org chart -->
<section class="eda-section eda-section-alt">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["About.Org.Eyebrow"]</span>
            <h2>@T["About.Org.Title"]</h2>
            <p>@T["About.Org.Text"]</p>
        </div>
        <div class="eda-org">
            <div class="eda-org-row"><div class="eda-org-node eda-org-top"><i class="bi bi-person-badge"></i> @CompanyData.OrgTop.Title</div></div>
            <div class="eda-org-row eda-org-branch">
                @foreach (var m in CompanyData.OrgManagers)
                {
                    <div class="eda-org-node @(m.LeadsProjectTeam ? "eda-org-pm" : "")">@m.Title</div>
                }
            </div>
            <div class="eda-org-row eda-org-branch eda-org-team">
                @foreach (var t in CompanyData.OrgProjectTeam)
                {
                    <div class="eda-org-node eda-org-leaf">@t.Title</div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Licenses -->
<section class="eda-section">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["About.Licenses.Eyebrow"]</span>
            <h2>@T["About.Licenses.Title"]</h2>
            <p>@T["About.Licenses.Text"]</p>
        </div>
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4">
                <ul class="eda-license-list">
                    <li><span>@T["About.Licenses.TradeName"]</span><strong>@CompanyData.Name</strong></li>
                    <li><span>@T["About.Licenses.UnifiedNumber"]</span><strong>@CompanyData.UnifiedNumber</strong></li>
                    <li><span>@T["About.Licenses.CrNumber"]</span><strong>@CompanyData.CrNumber</strong></li>
                    <li><span>@T["About.Licenses.VatNumber"]</span><strong>@CompanyData.VatNumber</strong></li>
                    <li><span>@T["About.Licenses.IssueDate"]</span><strong>@CompanyData.CrIssueDate</strong></li>
                </ul>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a class="eda-cert" href="~/images/site/cert-cr.jpg" data-eda-lightbox data-caption="@T["About.Licenses.CrCertificate"]">
                    <img src="~/images/site/cert-cr.jpg" alt="@T["About.Licenses.CrCertificate"]" loading="lazy" />
                    <span>@T["About.Licenses.CrCertificate"]</span>
                </a>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a class="eda-cert" href="~/images/site/cert-vat.jpg" data-eda-lightbox data-caption="@T["About.Licenses.VatCertificateFull"]">
                    <img src="~/images/site/cert-vat.jpg" alt="@T["About.Licenses.VatCertificateFull"]" loading="lazy" />
                    <span>@T["About.Licenses.VatCertificate"]</span>
                </a>
            </div>
        </div>
    </div>
</section>

<partial name="_Clients" />
<partial name="_CtaBand" />
<partial name="_Lightbox" />
