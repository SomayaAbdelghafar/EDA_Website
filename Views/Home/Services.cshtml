@{
    ViewData["Title"] = T["Shared.Nav.Services"].Value;
    ViewData["Heading"] = T["Services.Heading"].Value;
    ViewData["SeoTitle"] = T["Services.SeoTitle"].Value;
    ViewData["Subtitle"] = T["Services.Subtitle"].Value;
    ViewData["Description"] = T["Services.Description"].Value;
    ViewData["HeaderImage"] = "/images/site/technician.jpg";
}
<partial name="_PageHeader" />

<!-- Quick index -->
<section class="eda-section pb-0">
    <div class="container">
        <div class="eda-service-index">
            @foreach (var s in CompanyData.Services)
            {
                <a href="#@s.Slug"><i class="bi @s.Icon"></i><span>@s.Title</span></a>
            }
        </div>
    </div>
</section>

<!-- Service details -->
<section class="eda-section">
    <div class="container">
        @for (var i = 0; i < CompanyData.Services.Count; i++)
        {
            var s = CompanyData.Services[i];
            <article class="eda-service-row" id="@s.Slug">
                <div class="row g-4 g-lg-5 align-items-center">
                    <div class="col-lg-5 @(i % 2 == 1 ? "order-lg-2" : "")">
                        <img src="@s.Image" alt="@s.Heading" class="img-fluid rounded-4 shadow-sm eda-cover" loading="lazy" />
                    </div>
                    <div class="col-lg-7">
                        <span class="eda-service-num">0@(i + 1)</span>
                        <h2 class="eda-title"><i class="bi @s.Icon text-success"></i> @s.Title</h2>
                        <p>@s.Description</p>
                        <ul class="eda-checklist">
                            @foreach (var point in s.Points)
                            {
                                <li>@point</li>
                            }
                        </ul>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-primary" asp-controller="Home" asp-action="ServiceDetails" asp-route-slug="@s.Slug">@T["Services.DetailsAndFaq"] <i class="bi bi-arrow-left eda-flip-ltr"></i></a>
                            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Contact" asp-route-service="@s.Slug">@T["Services.RequestThis"]</a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- Process -->
<section class="eda-section eda-section-alt">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["Services.Process.Eyebrow"]</span>
            <h2>@T["Services.Process.Title"]</h2>
            <p>@T["Services.Process.Text"]</p>
        </div>
        <ol class="eda-process">
            @for (var i = 0; i < CompanyData.Process.Count; i++)
            {
                var step = CompanyData.Process[i];
                <li>
                    <span class="eda-process-icon"><i class="bi @step.Icon"></i><b>@(i + 1)</b></span>
                    <h3>@step.Title</h3>
                    <p>@step.Description</p>
                </li>
            }
        </ol>
    </div>
</section>

<!-- Sectors -->
<section class="eda-section">
    <div class="container">
        <div class="eda-section-head">
            <span class="eda-eyebrow">@T["Services.Sectors.Eyebrow"]</span>
            <h2>@T["Services.Sectors.Title"]</h2>
        </div>
        <div class="eda-sectors">
            <div><i class="bi bi-house-door"></i>@T["Services.Sectors.Villas"]</div>
            <div><i class="bi bi-buildings"></i>@T["Services.Sectors.Towers"]</div>
            <div><i class="bi bi-moon-stars"></i>@T["Services.Sectors.Mosques"]</div>
            <div><i class="bi bi-shop"></i>@T["Services.Sectors.Malls"]</div>
            <div><i class="bi bi-bank"></i>@T["Services.Sectors.Banks"]</div>
            <div><i class="bi bi-cup-hot"></i>@T["Services.Sectors.Restaurants"]</div>
            <div><i class="bi bi-film"></i>@T["Services.Sectors.Cinemas"]</div>
            <div><i class="bi bi-building-gear"></i>@T["Services.Sectors.Government"]</div>
        </div>
    </div>
</section>

<partial name="_CtaBand" />
