@model ContactViewModel
@{
    ViewData["Title"] = "تواصل معنا";
    ViewData["Subtitle"] = "يسعدنا تواصلكم معنا لطلب عرض سعر أو حجز موعد صيانة أو أي استفسار.";
    ViewData["Description"] = "تواصل مع شركة إيدا للتكييف والتبريد في جدة: الهاتف، الواتساب، البريد الإلكتروني، والعنوان – تقاطع شارع صاري مع طريق المدينة.";
    ViewData["HeaderImage"] = "/images/site/chillers.jpg";
    var success = TempData["ContactSuccess"] as string;
    // Static preview on GitHub Pages has no server to receive the form (see tools/export_static.py)
    var staticPreview = Configuration.GetValue<bool>("StaticPreview");
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-telephone"></i>
                    <h3>اتصل بنا</h3>
                    <a href="tel:@CompanyData.Phone1" dir="ltr">@CompanyData.Phone1Display</a>
                    <a href="tel:@CompanyData.Phone2" dir="ltr">@CompanyData.Phone2Display</a>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-whatsapp"></i>
                    <h3>واتساب</h3>
                    <a href="@CompanyData.WhatsAppUrl()" target="_blank" rel="noopener" dir="ltr">@CompanyData.Phone2Display</a>
                    <small>تواصل مباشر وسريع</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-envelope"></i>
                    <h3>البريد الإلكتروني</h3>
                    <a href="mailto:@CompanyData.Email">@CompanyData.Email</a>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-geo-alt"></i>
                    <h3>العنوان</h3>
                    <a href="@CompanyData.MapLinkUrl" target="_blank" rel="noopener">@CompanyData.Address</a>
                </div>
            </div>
        </div>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-7">
                <div class="eda-form-card">
                    <h2 class="eda-title">أرسل لنا طلبك</h2>
                    <p class="text-secondary">املأ النموذج وسيتواصل معك أحد مهندسينا في أقرب وقت.</p>

                    @if (success is not null)
                    {
                        <div class="alert alert-success d-flex gap-2 align-items-start" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>شكرًا لك يا @success، تم استلام طلبك بنجاح وسنتواصل معك قريبًا. للحالات العاجلة يمكنك الاتصال بنا مباشرة.</div>
                        </div>
                    }

                    @if (ViewData["ContactError"] is true)
                    {
                        <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>عذرًا، تعذّر إرسال طلبك حاليًا بسبب خلل تقني. يرجى المحاولة مرة أخرى بعد قليل، أو التواصل معنا مباشرة على الرقم <a href="tel:@CompanyData.Phone1" dir="ltr">@CompanyData.Phone1Display</a> أو عبر زر واتساب بالأسفل.</div>
                        </div>
                    }

                    @if (staticPreview)
                    {
                        <div class="alert alert-info d-none gap-2 align-items-start" role="alert" id="previewNotice">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <div>هذه نسخة عرض تجريبية من الموقع، لذلك لا يتم إرسال النموذج حاليًا وسيعمل بعد إطلاق الموقع رسميًا. يمكنك إرسال طلبك الآن عبر زر واتساب.</div>
                        </div>
                    }

                    <form asp-action="Contact" method="post" novalidate id="contactForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        @* Honeypot against spam bots: hidden from visitors and screen readers *@
                        <div class="visually-hidden" aria-hidden="true">
                            <label for="Website">اترك هذا الحقل فارغًا</label>
                            <input asp-for="Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" autocomplete="name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" type="tel" dir="ltr" autocomplete="tel" placeholder="05xxxxxxxx" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" dir="ltr" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" placeholder="جدة" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Service" class="form-label"></label>
                                <select asp-for="Service" class="form-select">
                                    <option value="">اختر الخدمة</option>
                                    @foreach (var s in CompanyData.Services)
                                    {
                                        <option value="@s.Title">@s.Title</option>
                                    }
                                    <option value="أخرى">أخرى</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label"></label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="اكتب نوع المبنى، المساحة التقريبية، ونوع الخدمة المطلوبة..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-send"></i> إرسال الطلب</button>
                                <button type="button" class="btn btn-outline-success btn-lg" id="sendWhatsApp" data-wa="@CompanyData.WhatsApp"><i class="bi bi-whatsapp"></i> إرسال عبر واتساب</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="eda-map">
                    <iframe src="@CompanyData.MapEmbedUrl" title="موقع شركة إيدا على الخريطة" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                </div>
                <div class="eda-hours mt-4">
                    <h3><i class="bi bi-info-circle"></i> لماذا تتواصل معنا؟</h3>
                    <ul class="eda-checklist mb-0">
                        <li>معاينة ودراسة الموقع وحساب الأحمال الحرارية</li>
                        <li>عروض أسعار مناسبة وواضحة</li>
                        <li>عقود صيانة سنوية للفلل والأبراج والمطاعم</li>
                        <li>مهندسون وفنيون على أعلى مستوى وخدمة سريعة في التنفيذ</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
