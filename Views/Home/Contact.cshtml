@model ContactViewModel
@{
    ViewData["Title"] = T["Shared.Nav.Contact"].Value;
    ViewData["Heading"] = T["Contact.Heading"].Value;
    ViewData["SeoTitle"] = T["Contact.SeoTitle"].Value;
    ViewData["Subtitle"] = T["Contact.Subtitle"].Value;
    ViewData["Description"] = T["Contact.Description"].Value;
    ViewData["HeaderImage"] = "/images/site/chillers.jpg";
    var success = TempData["ContactSuccess"] as string;
    // Static preview on GitHub Pages has no server to receive the form (see tools/export_static.py)
    var staticPreview = Configuration.GetValue<bool>("StaticPreview");
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-telephone"></i>
                    <h3>@T["Contact.Cards.Call"]</h3>
                    <a href="tel:@CompanyData.Phone1" dir="ltr">@CompanyData.Phone1Display</a>
                    <a href="tel:@CompanyData.Phone2" dir="ltr">@CompanyData.Phone2Display</a>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-whatsapp"></i>
                    <h3>@T["Contact.Cards.WhatsApp"]</h3>
                    <a href="@CompanyData.WhatsAppUrl()" target="_blank" rel="noopener" dir="ltr">@CompanyData.Phone2Display</a>
                    <small>@T["Contact.Cards.WhatsAppNote"]</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-envelope"></i>
                    <h3>@T["Contact.Cards.Email"]</h3>
                    <a href="mailto:@CompanyData.Email">@CompanyData.Email</a>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="eda-contact-card">
                    <i class="bi bi-geo-alt"></i>
                    <h3>@T["Contact.Cards.Address"]</h3>
                    <a href="@CompanyData.MapLinkUrl" target="_blank" rel="noopener">@CompanyData.Address</a>
                </div>
            </div>
        </div>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-7">
                <div class="eda-form-card">
                    <h2 class="eda-title">@T["Contact.Form.Title"]</h2>
                    <p class="text-secondary">@T["Contact.Form.Intro"]</p>

                    @if (success is not null)
                    {
                        @* data-eda-lead: site.js reports the sent request to Google Analytics as a lead (when analytics is on) *@
                        <div class="alert alert-success d-flex gap-2 align-items-start" role="alert" data-eda-lead>
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@T["Contact.Form.Success", success]</div>
                        </div>
                    }

                    @if (ViewData["ContactError"] is true)
                    {
                        <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@T.Html("Contact.Form.SendError", Html.Raw($"<a href=\"tel:{CompanyData.Phone1}\" dir=\"ltr\">{CompanyData.Phone1Display}</a>"))</div>
                        </div>
                    }

                    @if (staticPreview)
                    {
                        <div class="alert alert-info d-none gap-2 align-items-start" role="alert" id="previewNotice">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <div>@T["Contact.Form.PreviewNotice"]</div>
                        </div>
                    }

                    <form asp-action="Contact" method="post" novalidate id="contactForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        @* Honeypot against spam bots: hidden from visitors and screen readers *@
                        <div class="visually-hidden" aria-hidden="true">
                            <label for="Website">@T["Contact.Form.Honeypot"]</label>
                            <input asp-for="Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" autocomplete="name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" type="tel" dir="ltr" autocomplete="tel" placeholder="05xxxxxxxx" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" dir="ltr" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" placeholder="@T["Contact.Form.CityPlaceholder"]" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Service" class="form-label"></label>
                                @* Values are the language-neutral slugs, so a chosen service survives a language switch *@
                                <select asp-for="Service" class="form-select">
                                    <option value="">@T["Contact.Form.ChooseService"]</option>
                                    @foreach (var s in CompanyData.Services)
                                    {
                                        <option value="@s.Slug">@s.Title</option>
                                    }
                                    <option value="@ContactViewModel.OtherService">@T["Contact.Form.OtherService"]</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label"></label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="@T["Contact.Form.MessagePlaceholder"]"></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-send"></i> @T["Contact.Form.Submit"]</button>
                                <button type="button" class="btn btn-outline-success btn-lg" id="sendWhatsApp" data-wa="@CompanyData.WhatsApp"><i class="bi bi-whatsapp"></i> @T["Contact.Form.SendWhatsApp"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="eda-map">
                    <iframe src="@CompanyData.MapEmbedUrl" title="@T["Contact.MapTitle"]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                </div>
                <div class="eda-hours mt-4">
                    <h3><i class="bi bi-info-circle"></i> @T["Contact.Why.Title"]</h3>
                    <ul class="eda-checklist mb-0">
                        @foreach (var reason in Translations.List("Contact.Why.Points"))
                        {
                            <li>@reason</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
