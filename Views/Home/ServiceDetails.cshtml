@model Service
@*
    One page per service (/services/{slug}). Its text lives in Resources/Translations/{language}/Data.Services.json,
    so each page can target its own searches, e.g. "صيانة تكييف مركزي جدة" / "central AC maintenance Jeddah".
*@
@{
    ViewData["Title"] = Model.Title;
    ViewData["Heading"] = Model.Heading;
    ViewData["SeoTitle"] = Model.SeoTitle;
    ViewData["Description"] = Model.MetaDescription;
    ViewData["Subtitle"] = Model.ShortDescription;
    ViewData["HeaderImage"] = Model.Image;
    ViewData["Breadcrumb"] = ((string, string)?)(T["Shared.Nav.Services"], Url.Action("Services", "Home")!);
    var related = Model.RelatedProjects.Select(CompanyData.FindProject).OfType<Project>().ToList();
    var otherServices = CompanyData.Services.Where(s => s.Slug != Model.Slug).ToList();
    var baseUrl = SiteUrls.Base(Context.Request, Configuration);
}
<partial name="_PageHeader" />

<section class="eda-section">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <article class="eda-service-page">
                    <img src="@Model.Image" alt="@Model.Heading" class="img-fluid rounded-4 shadow-sm eda-cover mb-4" />
                    <p class="lead">@Model.Description</p>
                    @foreach (var paragraph in Model.Details)
                    {
                        <p>@paragraph</p>
                    }

                    @if (Model.Includes.Count > 0)
                    {
                        <h2 class="eda-title mt-5">@T["Services.Page.Includes"]</h2>
                        <ul class="eda-checklist">
                            @foreach (var item in Model.Includes)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }

                    @if (Model.SuitableFor.Count > 0)
                    {
                        <h2 class="eda-title mt-5">@T["Services.Page.SuitableFor"]</h2>
                        <ul class="eda-service-tags">
                            @foreach (var place in Model.SuitableFor)
                            {
                                <li>@place</li>
                            }
                        </ul>
                    }
                </article>
            </div>
            <div class="col-lg-4">
                <aside class="eda-project-info eda-service-aside">
                    <h2>@T["Services.Page.Request.Title"]</h2>
                    <p class="text-secondary">@T["Services.Page.Request.Text"]</p>
                    <a class="btn btn-success w-100" asp-controller="Home" asp-action="Contact" asp-route-service="@Model.Slug"><i class="bi bi-send"></i> @T["Shared.Actions.RequestQuote"]</a>
                    <a class="btn btn-outline-success w-100 mt-2" href="@CompanyData.WhatsAppUrl(T["Shared.WhatsApp.ServiceMessage", Model.Title])" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> @T["Shared.WhatsApp.Label"]</a>
                    <a class="btn btn-outline-primary w-100 mt-2" href="tel:@CompanyData.Phone1"><i class="bi bi-telephone"></i> <span dir="ltr">@CompanyData.Phone1Display</span></a>

                    <nav class="eda-service-links" aria-label="@T["Services.Page.OtherServices"]">
                        <h3>@T["Services.Page.OtherServices"]</h3>
                        <ul>
                            @foreach (var other in otherServices)
                            {
                                <li><a asp-controller="Home" asp-action="ServiceDetails" asp-route-slug="@other.Slug"><i class="bi @other.Icon"></i> @other.Title</a></li>
                            }
                        </ul>
                    </nav>
                </aside>
            </div>
        </div>
    </div>
</section>

@if (related.Count > 0)
{
    <section class="eda-section eda-section-alt">
        <div class="container">
            <div class="eda-section-head">
                <span class="eda-eyebrow">@T["Shared.Nav.Projects"]</span>
                <h2>@T["Services.Page.Related.Title"]</h2>
                <p>@T["Services.Page.Related.Text"]</p>
            </div>
            <div class="row g-4">
                @foreach (var p in related)
                {
                    <div class="col-md-6 col-lg-4"><partial name="_ProjectCard" model="p" /></div>
                }
            </div>
            <div class="text-center mt-5">
                <a class="btn btn-primary" asp-controller="Projects" asp-action="Index">@T["Shared.Actions.AllProjects"] <i class="bi bi-arrow-left eda-flip-ltr"></i></a>
            </div>
        </div>
    </section>
}

@if (Model.Faqs.Count > 0)
{
    <section class="eda-section">
        <div class="container">
            <div class="eda-section-head">
                <span class="eda-eyebrow">@T["Services.Page.Faq.Eyebrow"]</span>
                <h2>@T["Services.Page.Faq.Title"]</h2>
            </div>
            <div class="eda-faq">
                @foreach (var faq in Model.Faqs)
                {
                    <details>
                        <summary><h3>@faq.Question</h3></summary>
                        <p>@faq.Answer</p>
                    </details>
                }
            </div>
        </div>
    </section>
}

<partial name="_CtaBand" />

@StructuredData.ScriptTag(StructuredData.Service(Model, baseUrl))
